# ------------------------------------------------------------------------------
# Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env or serviceAccountKey.json to version control!
# ------------------------------------------------------------------------------

# Brevo (Sendinblue) API Credentials
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SENDER_EMAIL=mudasir@example.com
SENDER_NAME=Shopping App Support

# Firebase Admin Configuration
# Option 1: Path to service account JSON (for local testing)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Base64-encoded service account JSON (for Vercel deployment)
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyAidHlwZSI6ICJzZXJ2aWNlX2FjY291bnQiLCAi...
